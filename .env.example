# Copy this file to backend/.env (or set these in your hosting dashboard).
# EVERYTHING here is optional for local use — the site runs with no configuration at all.

# ---- Database ---------------------------------------------------------------
# Leave empty  -> SQLite file at backend/data/biscotti.db   (local / VPS / Render disk / Railway volume)
# Set it       -> PostgreSQL (Neon, Supabase, Render, Railway…)  REQUIRED on Vercel
DATABASE_URL=
# SQLite only: where to keep the database file (point this at a persistent disk in production)
# DATA_DIR=/data

# ---- First-run staff login (only used the very first time the database is created) ----
# After that, change it from the site: Staff mode -> Change password.
STAFF_USERNAME=staff
STAFF_PASSWORD=
STAFF_EMAIL=

# ---- Security ----------------------------------------------------------------
# Your site's public address; used in password-reset emails.  e.g. https://www.biscotti.in
PUBLIC_URL=
# Optional: fixed secret for login tokens (otherwise one is generated and stored in the database)
SESSION_SECRET=

# ---- "Forgot password?" emails (any SMTP provider; Gmail needs an App Password) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

PORT=3000
